{
 "compilerOptions": {
  "target": "ES2022",
  "module": "ESNext",
  "moduleResolution": "Bundler",
  "strict": true,
  "noEmit": true,
  "skipLibCheck": true,
  "lib": [
   "ES2022",
   "DOM"
  ],
  "types": [
   "node"
  ],
  "noImplicitAny": false,
  "jsx": "preserve",
  "paths": {
   "@/*": [
    "./*"
   ]
  },
  "allowJs": false,
  "esModuleInterop": true,
  "isolatedModules": true,
  "resolveJsonModule": true,
  "incremental": true,
  "plugins": [
   {
    "name": "next"
   }
  ]
 },
 "include": [
  "engine/src/**/*.ts",
  "lib/**/*.ts",
  "worker/**/*.ts",
  "web/**/*.ts",
  "app/**/*.ts",
  "app/**/*.tsx",
  "next-env.d.ts",
  ".next/types/**/*.ts"
 ],
 "exclude": [
  "node_modules",
  "productions",
  "scratch"
 ]
}